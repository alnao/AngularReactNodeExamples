# Copiare in server-php/.env e adattare. Il file .env NON va committato.
DB_HOST=127.0.0.1
DB_NAME=bookexample
DB_PORT=4242
DB_USER=root
DB_PASS=xxxx
# Segreto per firmare i JWT di auth/index.php: almeno 32 caratteri casuali.
# Generarlo ad esempio con:  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
JWT_SECRET=
