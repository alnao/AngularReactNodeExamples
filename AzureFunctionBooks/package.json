{
  "name": "azure-function-books-crud",
  "version": "2.0.0",
  "description": "API REST CRUD dei libri con Azure Functions v4 in TypeScript e Azure Cosmos DB serverless",
  "main": "dist/index.js",
  "author": "alnao",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "local:settings": "node scripts/ensure-local-settings.js",
    "local:db": "docker compose up -d cosmos-emulator",
    "local:db:stop": "docker compose down",
    "local:seed": "tsx scripts/seed.ts",
    "start": "npm run local:settings && npm run build && func start",
    "deploy": "./start-all.sh",
    "destroy": "./stop-all.sh"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.2",
    "@azure/functions": "^4.17.1",
    "@azure/identity": "^4.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  }
}
